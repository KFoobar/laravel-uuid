{
    "name": "kfoobar/laravel-uuid",
    "description": "UUID Trait for Eloquent Models in Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "KFoobar",
            "email": "david@kfoobar.se"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "ramsey/uuid": "^4.2.2"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5.10|^10.1|^11.0|^12.0|^13.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "KFoobar\\Uuid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KFoobar\\Uuid\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
